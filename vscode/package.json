{
  "name": "c-atlas",
  "displayName": "C Atlas",
  "description": "Explore C projects with live, interactive call graphs, file dependencies and source navigation.",
  "version": "0.3.0",
  "publisher": "Pconst167",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pconst167/c-atlas.git",
    "directory": "vscode"
  },
  "homepage": "https://github.com/Pconst167/c-atlas/tree/main/vscode",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Visualization", "Programming Languages"],
  "keywords": ["C", "call graph", "headers", "dependencies", "visualization"],
  "extensionKind": ["workspace"],
  "capabilities": {
    "untrustedWorkspaces": { "supported": true },
    "virtualWorkspaces": { "supported": true }
  },
  "main": "./extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "cAtlas.fileGraph",
        "displayName": "C Atlas",
        "selector": [{ "filenamePattern": "*.{c,h,hh,hpp,hxx,inl,inc}" }],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "cAtlas.exploreWorkspace",
        "title": "Explore Workspace",
        "category": "C Atlas"
      },
      {
        "command": "cAtlas.showFileInGraph",
        "title": "Show in C Atlas"
      },
      {
        "command": "cAtlas.enableExplorerGraph",
        "title": "Enable Graph Opens in This Workspace",
        "category": "C Atlas"
      },
      {
        "command": "cAtlas.disableExplorerGraph",
        "title": "Disable Graph Opens in This Workspace",
        "category": "C Atlas"
      }
    ],
    "configuration": {
      "title": "C Atlas",
      "properties": {
        "cAtlas.followFilePreviews": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Follow C sources and headers in the open graph. From the graph you can also select an already-open file or work with editor previews disabled."
        }
      }
    },
    "menus": {
      "commandPalette": [
        { "command": "cAtlas.enableExplorerGraph", "when": "workspaceFolderCount > 0" },
        { "command": "cAtlas.disableExplorerGraph", "when": "workspaceFolderCount > 0" },
        { "command": "cAtlas.exploreWorkspace", "when": "workspaceFolderCount > 0" },
        { "command": "cAtlas.showFileInGraph", "when": "workspaceFolderCount > 0 && resourceExtname =~ /^\\.(c|h|hh|hpp|hxx|inc|inl)$/i" }
      ],
      "explorer/context": [
        { "command": "cAtlas.showFileInGraph", "when": "!explorerResourceIsFolder && workspaceFolderCount > 0 && resourceExtname =~ /^\\.(c|h|hh|hpp|hxx|inc|inl)$/i", "group": "navigation@50" }
      ]
    }
  },
  "scripts": {
    "build": "node build-webview.js",
    "test": "npm run build && node --test test/*.test.js",
    "vscode:prepublish": "npm run build"
  }
}
